# Server environment only. Never prefix credentials with VITE_.
VIEWER_API_PORT=4100
# Absolute path to your private MCP provider module. Copy provider.example.mjs and
# supply the verified Arena endpoint, per-user session bridge and reviewed bindings:
# ARENA_PROVIDER_MODULE=/srv/assembly-review/arena-provider.mjs
# User credentials belong to the trusted session bridge/secret manager, never this file.
# There is intentionally no ARENA_ACCESS_TOKEN, administrator fallback, or VITE_ secret.
# Explicit development reference only; select in your private provider module:
# ARENA_MCP_ENDPOINT=https://mcp-dev.srv.aws.bom.com/sand26/mcp
# /sand26/mcp and the guide's general /mcp are not assumed interchangeable.
# No production MCP endpoint has been verified.
# Register the exact application's callback URI, for example:
# ARENA_OAUTH_REDIRECT_URI=https://YOUR-VIEWER/api/viewer/v1/auth/callback
# OAuth client registration/CIMD settings, identity verification, store, session-cookie
# key and approved discovery origins are private server module configuration.
